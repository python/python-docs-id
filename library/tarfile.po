msgid ""
"For symbolic links (``SYMTYPE``), the *linkname* is relative to the "
"directory that contains the link. For hard links (``LNKTYPE``), the "
"*linkname* is relative to the root of the archive."
msgstr ""
"Для символических ссылок (``SYMTYPE``) *linkname* относится к каталогу, в "
"котором содержится ссылка. Для жестких ссылок (``LNKTYPE``) *linkname* "
"относится к корню архива."

msgid "User ID of the user who originally stored this member."
msgstr "Ідентифікатор користувача, який спочатку зберіг цього учасника."

msgid "Group ID of the user who originally stored this member."
msgstr "Ідентифікатор групи користувача, який спочатку зберіг цього учасника."

msgid "User name."
msgstr "Ім'я користувача."

msgid "Group name."
msgstr "Назва групи."

